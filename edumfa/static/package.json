{
  "name": "edumfa-ui",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tanstack/react-query": "^5.104.3",
    "angular": "1.8.3",
    "angular-gettext": "2.4.2",
    "angular-hotkeys": "1.7.0",
    "angular-inform": "0.0.19",
    "angular-sanitize": "1.8.3",
    "angular-ui-bootstrap": "2.5.6",
    "angular-ui-router": "1.0.30",
    "bootstrap": "3.4.1",
    "isteven-angular-multiselect": "4.0.0",
    "jquery": "3.7.1",
    "ng-file-upload": "12.2.13",
    "ng-idle": "1.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "grunt-angular-gettext": "2.5.3",
    "grunt-cli": "1.5.0",
    "grunt-init": "0.3.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "react:dev": "vite --host 127.0.0.1",
    "react:build": "bun run intl:compile && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint react-src vite.config.mts playwright.config.ts --max-warnings=0",
    "format:check": "prettier --check \"react-src/**/*.{ts,tsx,css,md}\" \"*.{mts,mjs,cjs,json}\"",
    "intl:compile": "lingui compile --typescript",
    "intl:extract": "lingui extract --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "translate": "grunt nggettext_extract && for language in translations/*.po; do msgmerge -U --backup=off $language translations/template.pot; done && grunt nggettext_compile"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edumfa/edumfa.git"
  },
  "keywords": [],
